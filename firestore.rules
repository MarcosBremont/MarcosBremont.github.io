rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function currentRole() {
      return signedIn()
        ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol
        : null;
    }

    // Lista de roles del usuario actual. Si tiene el campo "roles" (multi-rol) lo usa;
    // si no (cuentas viejas, migracion perezosa), cae al campo singular "rol".
    function misRoles() {
      let perfil = signedIn() ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data : null;
      return perfil == null ? [] : (perfil.get('roles', null) != null ? perfil.roles : [perfil.get('rol', null)]);
    }

    function hasRole(roles) {
      return signedIn() && misRoles().hasAny(roles);
    }

    function isOwnerSuperadminEmail() {
      return signedIn() && request.auth.token.email == 'soymarcosbremont@gmail.com';
    }

    function isConfiguredSuperadminEmail() {
      return signedIn()
        && exists(/databases/$(database)/documents/config/superadmin)
        && get(/databases/$(database)/documents/config/superadmin).data.emails != null
        && request.auth.token.email in get(/databases/$(database)/documents/config/superadmin).data.emails;
    }

    function isSuperadminByEmail() {
      return isOwnerSuperadminEmail() || isConfiguredSuperadminEmail();
    }

    // .get('centroId', null) en vez de acceso directo: leer un campo ausente con
    // notacion de punto lanza un error de evaluacion (no null) y tumba el permiso
    // completo -- el mismo problema que ya se resolvio en mismoCentroOSinCentro().
    function miCentroId() {
      return signedIn() ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('centroId', null) : null;
    }

    // Compara mi centro contra el centro del dueño de un doc ubicado en users/{otroUid}/... o usuarios/{otroUid}
    function mismoCentro(otroUid) {
      return otroUid != null && miCentroId() != null &&
             miCentroId() == get(/databases/$(database)/documents/usuarios/$(otroUid)).data.get('centroId', null);
    }

    // Compara mi centro contra un campo centroId estampado en el propio documento leido.
    // Si el documento no tiene centroId (p.ej. enviado de forma anonima), no se filtra por centro.
    // Usa .get() con valor por defecto: leer un campo ausente directamente (resource.data.centroId)
    // hace fallar la evaluacion de la regla para ESE documento en consultas collectionGroup,
    // y como ningun reportes_comportamiento/denuncia tiene centroId hoy, eso bloqueaba TODO.
    function mismoCentroOSinCentro() {
      return resource.data.get('centroId', null) == null || resource.data.get('centroId', null) == miCentroId();
    }

    function canReadConvivenciaGlobal(ownerUid) {
      return signedIn() && (
        isSuperadminByEmail() || currentRole() == 'superadmin' ||
        (hasRole(['psicologia', 'psicologa', 'psicologo', 'coordinadora', 'director', 'admin_centro']) && mismoCentro(ownerUid))
      );
    }

    // Variante para rutas collectionGroup donde el uid del dueno no esta disponible en la ruta
    // (el comodin ** se lo come); se compara contra un centroId estampado en el propio documento.
    function canReadConvivenciaGlobalPorDoc() {
      return signedIn() && (
        isSuperadminByEmail() || currentRole() == 'superadmin' ||
        (hasRole(['psicologia', 'psicologa', 'psicologo', 'coordinadora', 'director', 'admin_centro']) && mismoCentroOSinCentro())
      );
    }

    function canReadConvivenciaOwnerOrPsico(ownerUid) {
      return signedIn() && (
        request.auth.uid == ownerUid ||
        canReadConvivenciaGlobal(ownerUid)
      );
    }

    match /config/{doc} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    // Contador público de usuarios registrados, para mostrar "N personas registradas"
    // fuera de la app (p.ej. un portafolio) sin exponer la coleccion usuarios/ completa.
    // Solo se puede crear en 1 y despues subir de a 1 -- nunca saltar ni bajar el numero.
    match /stats/publico {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.usuariosRegistrados == 1;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usuariosRegistrados'])
        && request.resource.data.usuariosRegistrados == resource.data.usuariosRegistrados + 1;
    }

    match /centros/{centroId} {
      allow read: if true;
      allow write: if signedIn();

      match /avisos/{avisoId} {
        allow read, write: if signedIn();
      }

      // Casos de seguimiento de rendimiento académico abiertos por Coordinadora
      // (pestaña Rendimiento del Panel Coordinadora). Mismo patrón que avisos:
      // el gating de quién puede escribir vive en la UI, no en la regla.
      match /alertas_rendimiento/{alertaId} {
        allow read, write: if signedIn();
      }

      match /pagos_config/{doc} {
        allow read, write: if signedIn();
      }

      match /calendario/{doc} {
        allow read: if signedIn();
        allow write: if signedIn() && (isSuperadminByEmail() || currentRole() == 'superadmin');
      }

      // Módulo de Vinculación Sectorial (pasantías, bolsa de empleo, diagnósticos
      // empresariales, convenios, eventos comunitarios). Mismo patrón que avisos/
      // alertas_rendimiento: regla plana, el gating de quién puede escribir vive en
      // la UI (rol 'vinculadora' + Director/admin_centro/Superadmin), no en la regla.
      match /vinc_pasantias_estudiantes/{id} { allow read, write: if signedIn(); }
      match /vinc_pasantias_docentes/{id}    { allow read, write: if signedIn(); }
      match /vinc_bolsa_empleo/{id}          { allow read, write: if signedIn(); }
      match /vinc_diagnosticos/{id}          { allow read, write: if signedIn(); }
      match /vinc_convenios/{id}             { allow read, write: if signedIn(); }
      match /vinc_eventos/{id}               { allow read, write: if signedIn(); }

      // Compartir entre docentes del mismo centro (links/documentos), con visibilidad
      // por destinatario. Aislado por centro (a diferencia de avisos, que no lo esta).
      match /compartidos/{itemId} {
        // OJO: en consultas "list", si UN SOLO documento candidato no cumple la
        // condicion, Firestore rechaza la consulta ENTERA (no filtra en silencio).
        // Por eso el bypass de superadmin debe saltarse tambien el chequeo de
        // visibilidad, no solo el de "mismo centro" -- si no, un item privado de
        // otro docente tumba la lista completa para el superadmin.
        allow read: if signedIn() && (
          isSuperadminByEmail() || currentRole() == 'superadmin' ||
          (miCentroId() == centroId && (
            resource.data.visibilidad == 'todos' ||
            resource.data.autorUid == request.auth.uid ||
            request.auth.uid in resource.data.get('destinatarios', [])
          ))
        );
        allow create: if signedIn() && (isSuperadminByEmail() || currentRole() == 'superadmin' || miCentroId() == centroId)
                      && request.resource.data.autorUid == request.auth.uid;
        allow delete: if signedIn() && resource.data.autorUid == request.auth.uid;
        allow update: if false;
      }
    }

    match /perfiles/{userId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /avisos/{avisoId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /usuarios/{uid} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /users/{userId}/data/cuentas_estudiantes {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/data/{doc} {
      allow read, write: if signedIn() && request.auth.uid == userId;
      allow read: if isSuperadminByEmail() || currentRole() == 'superadmin' ||
                     (hasRole(['coordinadora', 'director', 'admin_centro']) && mismoCentro(userId));
    }

    match /users/{userId}/sessions/{sessionId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Evidencias del Portafolio Docente: un documento por evidencia (a diferencia de
    // users/{userId}/data/{doc}, que guarda un blob unico) para poder adjuntar archivos
    // sin toparse con el limite de 1 MiB por documento de Firestore. Sin chequeo por
    // resource.data (solo depende de userId), asi que no aplica el gotcha de "list" que
    // tuvo compartidos: el propio docente siempre puede listar todo lo suyo.
    match /users/{userId}/portafolio_evidencias/{itemId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
      allow read: if isSuperadminByEmail() || currentRole() == 'superadmin' ||
                     (hasRole(['coordinadora', 'director', 'admin_centro']) && mismoCentro(userId));

      // Adjunto de la evidencia (hasta 5 MB), partido en chunks -- mismo motivo que
      // portafolio_evidencias en si: no cabe en un solo documento.
      match /archivo/{chunkId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
        allow read: if isSuperadminByEmail() || currentRole() == 'superadmin' ||
                       (hasRole(['coordinadora', 'director', 'admin_centro']) && mismoCentro(userId));
      }
    }

    // Evidencia adjunta a una excusa de asistencia (certificado médico, carta, etc.):
    // un documento por (curso, fecha, estudiante), mismo criterio que portafolio_evidencias
    // -- el adjunto no cabe en el blob de asistencia (users/{userId}/data/asistencia).
    match /users/{userId}/asistencia_evidencias/{itemId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
      allow read: if isSuperadminByEmail() || currentRole() == 'superadmin' ||
                     (hasRole(['coordinadora', 'director', 'admin_centro']) && mismoCentro(userId));

      match /archivo/{chunkId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
        allow read: if isSuperadminByEmail() || currentRole() == 'superadmin' ||
                       (hasRole(['coordinadora', 'director', 'admin_centro']) && mismoCentro(userId));
      }
    }

    // Autoevaluación / plan de mejora del Portafolio Docente, un documento por año escolar.
    match /users/{userId}/portafolio_reflexion/{yearId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
      allow read: if isSuperadminByEmail() || currentRole() == 'superadmin' ||
                     (hasRole(['coordinadora', 'director', 'admin_centro']) && mismoCentro(userId));
    }

    // Evidencias PRIVADAS del Portafolio (ej. lo que se enlaza desde Mi Libreta):
    // a diferencia de portafolio_evidencias de arriba, aquí NO hay rama de lectura
    // para coordinadora/director/admin_centro/superadmin -- deliberadamente. Es el
    // único dato del portafolio que ni siquiera un supervisor del mismo centro puede
    // leer. Mismo patrón que users/{userId}/sessions (ver arriba): regla plana sin
    // depender de resource.data, para no reintroducir el gotcha de "list" que ya
    // documentamos en compartidos/mismoCentroOSinCentro.
    match /users/{userId}/portafolio_evidencias_privadas/{itemId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /error_logs/{logId} {
      allow create: if signedIn();
      allow read: if signedIn() && (
        isSuperadminByEmail() || currentRole() == 'superadmin' ||
        (hasRole(['admin_centro', 'director']) && mismoCentro(resource.data.get('uid', null)))
      );
      allow update, delete: if false;
    }

    match /public_blogs/{userId}/posts/{postId} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == userId;
    }

    match /public_blogs/{userId}/submissions/{subId} {
      allow create: if true;
      allow read, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /public_blogs/{userId}/reportes_comportamiento/{repId} {
      allow create: if true;
      allow read: if canReadConvivenciaOwnerOrPsico(userId);
      allow update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /public_blogs/{userId}/denuncias/{denId} {
      allow create: if true;
      allow read: if canReadConvivenciaOwnerOrPsico(userId);
      allow update, delete: if signedIn() && request.auth.uid == userId;
    }

    // Reglas explícitas para consultas collectionGroup globales
    // (evita permission-denied cuando existen colecciones con el mismo nombre en otras rutas).
    match /{path=**}/reportes_comportamiento/{repId} {
      allow read: if canReadConvivenciaGlobalPorDoc();
    }

    match /{path=**}/denuncias/{denId} {
      allow read: if canReadConvivenciaGlobalPorDoc();
    }

    match /public_blogs/{userId}/datos_padre/{estId} {
      // Publico a proposito: los padres abren el reporte via un link con id corto
      // (links_padre) sin haber iniciado sesion.
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == userId;
    }

    // Calendario global heredado (reemplazado por centros/{id}/calendario). Se deja de
    // solo lectura unicamente para poder copiar sus datos al centro correspondiente;
    // ya no acepta escrituras nuevas.
    match /public_calendar/{doc} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /examenes/{examenId} {
      allow read, update, delete: if signedIn()
                                  && request.auth.uid == resource.data.docenteUid;
      allow create: if signedIn()
                    && request.resource.data.docenteUid == request.auth.uid;
      allow read: if resource.data.activo == true;

      match /respuestas/{respId} {
        allow create: if true;
        allow read: if signedIn();
      }
    }

    match /links_alumno/{id} {
      allow read: if true;
      allow create: if signedIn();
    }

    match /links_padre/{id} {
      allow read: if true;
      allow create: if signedIn();
    }

    match /{path=**}/datos_padre/{estId} {
      allow read: if true;
    }
  }
}
