rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function currentRole() {
      return signedIn()
        ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol
        : null;
    }

    // Lista de roles del usuario actual. Si tiene el campo "roles" (multi-rol) lo usa;
    // si no (cuentas viejas, migracion perezosa), cae al campo singular "rol".
    function misRoles() {
      let perfil = signedIn() ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data : null;
      return perfil == null ? [] : (perfil.get('roles', null) != null ? perfil.roles : [perfil.get('rol', null)]);
    }

    function hasRole(roles) {
      return signedIn() && misRoles().hasAny(roles);
    }

    function isOwnerSuperadminEmail() {
      return signedIn() && request.auth.token.email == 'soymarcosbremont@gmail.com';
    }

    function isConfiguredSuperadminEmail() {
      return signedIn()
        && exists(/databases/$(database)/documents/config/superadmin)
        && get(/databases/$(database)/documents/config/superadmin).data.emails != null
        && request.auth.token.email in get(/databases/$(database)/documents/config/superadmin).data.emails;
    }

    function isSuperadminByEmail() {
      return isOwnerSuperadminEmail() || isConfiguredSuperadminEmail();
    }

    // .get('centroId', null) en vez de acceso directo: leer un campo ausente con
    // notacion de punto lanza un error de evaluacion (no null) y tumba el permiso
    // completo -- el mismo problema que ya se resolvio en mismoCentroOSinCentro().
    function miCentroId() {
      return signedIn() ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('centroId', null) : null;
    }

    // Compara mi centro contra el centro del dueño de un doc ubicado en users/{otroUid}/... o usuarios/{otroUid}
    function mismoCentro(otroUid) {
      return otroUid != null && miCentroId() != null &&
             miCentroId() == get(/databases/$(database)/documents/usuarios/$(otroUid)).data.get('centroId', null);
    }

    // Compara mi centro contra un campo centroId estampado en el propio documento leido.
    // Si el documento no tiene centroId (p.ej. enviado de forma anonima), no se filtra por centro.
    // Usa .get() con valor por defecto: leer un campo ausente directamente (resource.data.centroId)
    // hace fallar la evaluacion de la regla para ESE documento en consultas collectionGroup,
    // y como ningun reportes_comportamiento/denuncia tiene centroId hoy, eso bloqueaba TODO.
    function mismoCentroOSinCentro() {
      return resource.data.get('centroId', null) == null || resource.data.get('centroId', null) == miCentroId();
    }

    function canReadConvivenciaGlobal(ownerUid) {
      return signedIn() && (
        isSuperadminByEmail() || currentRole() == 'superadmin' ||
        (hasRole(['psicologia', 'psicologa', 'psicologo', 'coordinadora', 'director', 'admin_centro']) && mismoCentro(ownerUid))
      );
    }

    // Variante para rutas collectionGroup donde el uid del dueno no esta disponible en la ruta
    // (el comodin ** se lo come); se compara contra un centroId estampado en el propio documento.
    function canReadConvivenciaGlobalPorDoc() {
      return signedIn() && (
        isSuperadminByEmail() || currentRole() == 'superadmin' ||
        (hasRole(['psicologia', 'psicologa', 'psicologo', 'coordinadora', 'director', 'admin_centro']) && mismoCentroOSinCentro())
      );
    }

    function canReadConvivenciaOwnerOrPsico(ownerUid) {
      return signedIn() && (
        request.auth.uid == ownerUid ||
        canReadConvivenciaGlobal(ownerUid)
      );
    }

    match /config/{doc} {
      allow read: if signedIn();
      // Antes cualquier usuario logueado podia escribir aqui, incluyendo
      // config/superadmin (la lista de emails con acceso Superadmin) -- eso
      // permitia que cualquier docente se auto-agregara como superadmin con una
      // sola llamada a Firestore desde la consola del navegador. isOwnerSuperadminEmail()
      // no depende de este documento (es un email fijo), asi que el dueno de la
      // plataforma siempre puede escribir aqui incluso si config/superadmin no existe.
      allow write: if isSuperadminByEmail();
    }

    // Contador público de usuarios registrados, para mostrar "N personas registradas"
    // fuera de la app (p.ej. un portafolio) sin exponer la coleccion usuarios/ completa.
    // Solo se puede crear en 1 y despues subir de a 1 -- nunca saltar ni bajar el numero.
    match /stats/publico {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.usuariosRegistrados == 1;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usuariosRegistrados'])
        && request.resource.data.usuariosRegistrados == resource.data.usuariosRegistrados + 1;
    }

    match /centros/{centroId} {
      allow read: if true;
      // Solo Superadmin edita el documento del centro (nombre, logo, plantillas,
      // credenciales de EmailJS, lista de admins) -- la UI para esto (Superadmin >
      // Centros Educativos) ya esta gateada por _esSuperadmin() en el cliente; esta
      // regla es lo que realmente lo hace cumplir del lado del servidor. Antes
      // cualquier usuario logueado, de cualquier centro, podia sobreescribir estos
      // campos de CUALQUIER OTRO centro (incluyendo sus credenciales de EmailJS).
      allow write: if signedIn() && (isSuperadminByEmail() || currentRole() == 'superadmin');

      // Subcolecciones aisladas por centro: antes solo pedian signedIn(), sin comparar
      // el centroId del usuario contra el centroId de la ruta -- cualquier docente
      // logueado de OTRO centro que supiera/adivinara este centroId podia leer o
      // escribir aqui. Mismo patron ya usado en /compartidos (mas abajo): superadmin
      // pasa siempre, el resto solo si es su propio centro.
      match /avisos/{avisoId} {
        allow read, write: if signedIn() && (isSuperadminByEmail() || currentRole() == 'superadmin' || miCentroId() == centroId);
      }

      // Casos de seguimiento de rendimiento académico abiertos por Coordinadora
      // (pestaña Rendimiento del Panel Coordinadora).
      match /alertas_rendimiento/{alertaId} {
        allow read, write: if signedIn() && (isSuperadminByEmail() || currentRole() == 'superadmin' || miCentroId() == centroId);
      }

      match /pagos_config/{doc} {
        allow read, write: if signedIn() && (isSuperadminByEmail() || currentRole() == 'superadmin' || miCentroId() == centroId);
      }

      // Suscripcion mensual del centro (monto e historial de pagos): datos sensibles
      // que SOLO el superadmin puede ver, a diferencia de pagos_config (que el propio
      // centro tambien puede leer/escribir para cobrarle a SUS estudiantes). Aqui ni
      // admin_centro ni director del propio centro tienen acceso -- requisito de
      // negocio: nadie mas que el dueno de la plataforma ve montos/historial. Los
      // campos livianos que SI necesita ver cualquier cliente para calcular el
      // bloqueo (fechaPagadoHasta, suscripcionSuspendidaManual, diasGraciaSuscripcion)
      // viven en el documento raiz de centros/{centroId} de arriba, no aqui.
      match /suscripcion/{doc} {
        allow read, write: if signedIn() && (isSuperadminByEmail() || currentRole() == 'superadmin');
      }

      match /calendario/{doc} {
        allow read: if signedIn();
        allow write: if signedIn() && (isSuperadminByEmail() || currentRole() == 'superadmin');
      }

      // Módulo de Vinculación Sectorial (pasantías, bolsa de empleo, diagnósticos
      // empresariales, convenios, eventos comunitarios). Solo el rol 'vinculadora'
      // de ese mismo centro, o Superadmin -- ni Director ni admin_centro (aunque el
      // boton del dashboard llego a mostrarseles antes, _verificarAccesoVinculacion()
      // ya no los deja pasar).
      match /vinc_pasantias_estudiantes/{id} { allow read, write: if signedIn() && (isSuperadminByEmail() || currentRole() == 'superadmin' || (hasRole(['vinculadora']) && miCentroId() == centroId)); }
      match /vinc_pasantias_docentes/{id}    { allow read, write: if signedIn() && (isSuperadminByEmail() || currentRole() == 'superadmin' || (hasRole(['vinculadora']) && miCentroId() == centroId)); }
      match /vinc_bolsa_empleo/{id}          { allow read, write: if signedIn() && (isSuperadminByEmail() || currentRole() == 'superadmin' || (hasRole(['vinculadora']) && miCentroId() == centroId)); }
      match /vinc_diagnosticos/{id}          { allow read, write: if signedIn() && (isSuperadminByEmail() || currentRole() == 'superadmin' || (hasRole(['vinculadora']) && miCentroId() == centroId)); }
      match /vinc_convenios/{id}             { allow read, write: if signedIn() && (isSuperadminByEmail() || currentRole() == 'superadmin' || (hasRole(['vinculadora']) && miCentroId() == centroId)); }
      match /vinc_eventos/{id}               { allow read, write: if signedIn() && (isSuperadminByEmail() || currentRole() == 'superadmin' || (hasRole(['vinculadora']) && miCentroId() == centroId)); }

      // Compartir entre docentes del mismo centro (links/documentos), con visibilidad
      // por destinatario adicional al aislamiento por centro.
      match /compartidos/{itemId} {
        // OJO: en consultas "list", si UN SOLO documento candidato no cumple la
        // condicion, Firestore rechaza la consulta ENTERA (no filtra en silencio).
        // Por eso el bypass de superadmin debe saltarse tambien el chequeo de
        // visibilidad, no solo el de "mismo centro" -- si no, un item privado de
        // otro docente tumba la lista completa para el superadmin.
        allow read: if signedIn() && (
          isSuperadminByEmail() || currentRole() == 'superadmin' ||
          (miCentroId() == centroId && (
            resource.data.visibilidad == 'todos' ||
            resource.data.autorUid == request.auth.uid ||
            request.auth.uid in resource.data.get('destinatarios', [])
          ))
        );
        allow create: if signedIn() && (isSuperadminByEmail() || currentRole() == 'superadmin' || miCentroId() == centroId)
                      && request.resource.data.autorUid == request.auth.uid;
        allow delete: if signedIn() && resource.data.autorUid == request.auth.uid;
        allow update: if false;
      }
    }

    match /perfiles/{userId} {
      allow read: if signedIn();
      // El cliente (app.js) nunca escribe en esta coleccion, solo lee -- se deja
      // en superadmin-only por seguridad en vez de abierta a cualquier signedIn().
      allow write: if isSuperadminByEmail() || currentRole() == 'superadmin';
    }

    // Coleccion legado (distinta de centros/{id}/avisos, que es la que usa la app
    // hoy) -- no tiene ninguna referencia viva en app.js. Se deja superadmin-only
    // en vez de abierta a cualquier signedIn() por seguridad.
    match /avisos/{avisoId} {
      allow read: if signedIn();
      allow write: if isSuperadminByEmail() || currentRole() == 'superadmin';
    }

    match /usuarios/{uid} {
      allow read: if signedIn();

      // Antes cualquier usuario logueado podia sobreescribir el documento de
      // CUALQUIER OTRO usuario, incluyendo su propio campo "rol" a "superadmin"
      // (el cliente incluso tiene un flujo -- auth.js linea ~93-94 -- que intenta
      // auto-escribir rol:'superadmin'/'admin_centro' en el propio perfil, gateado
      // SOLO por un email guardado en localStorage/config -- editable por cualquiera
      // desde la consola del navegador). Ahora:
      // - el propio dueno solo puede CREAR su perfil como 'docente' pendiente
      //   (nunca auto-crearse ya aprobado como admin/superadmin), y solo puede
      //   ACTUALIZAR su propio documento si NO toca los campos rol/roles (nombre,
      //   pin, centroId, estado, etc. si se mantienen editables por el propio dueno);
      // - superadmin y admin_centro/director de SU MISMO centro (gestionando un
      //   docente de ese centro: _aprobarDocente, _rechazarDocente, _toggleRolDocente)
      //   pueden escribir cualquier campo, incluyendo rol/roles.
      // Efecto secundario aceptado: la auto-promocion de admin_centro/director "por
      // email conocido" al iniciar sesion por primera vez YA NO se guarda en Firestore
      // (ese chequeo es client-only y no puede replicarse en una regla sin escanear
      // todos los centros) -- esos roles ahora deben asignarse manualmente una vez
      // desde Superadmin > Centros > Docentes, igual que cualquier otro cambio de rol.
      // Se valida tambien "roles" (no solo "rol"): misRoles()/hasRole() prefieren el
      // arreglo "roles" sobre el campo singular "rol" cuando esta presente, asi que
      // dejar pasar rol:'docente' con roles:['admin_centro'] hubiera sido otra forma
      // de auto-promoverse.
      allow create: if signedIn() && request.auth.uid == uid &&
                       request.resource.data.get('rol', 'docente') == 'docente' &&
                       request.resource.data.get('roles', ['docente']).hasOnly(['docente']);

      allow update: if (
                          signedIn() && request.auth.uid == uid &&
                          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol', 'roles'])
                        )
                        || (signedIn() && (isSuperadminByEmail() || currentRole() == 'superadmin'))
                        || (signedIn() && hasRole(['admin_centro', 'director']) && mismoCentro(uid));
    }

    match /users/{userId}/data/cuentas_estudiantes {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/data/{doc} {
      allow read, write: if signedIn() && request.auth.uid == userId;
      allow read: if isSuperadminByEmail() || currentRole() == 'superadmin' ||
                     (hasRole(['coordinadora', 'director', 'admin_centro']) && mismoCentro(userId));
    }

    match /users/{userId}/sessions/{sessionId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Comentarios de un supervisor (coordinadora/director/admin_centro) sobre una
    // planificación específica de un docente: feedback dirigido. El docente dueño
    // solo puede leer y marcar como leído (affectedKeys hasOnly 'leido'), nunca
    // editar el texto ni crear comentarios a nombre de un supervisor. Solo el autor
    // del comentario (o superadmin) puede borrarlo.
    match /users/{userId}/plan_comentarios/{comentarioId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leido']);

      allow read: if isSuperadminByEmail() || currentRole() == 'superadmin' ||
                     (hasRole(['coordinadora', 'director', 'admin_centro']) && mismoCentro(userId));
      allow create: if (isSuperadminByEmail() || currentRole() == 'superadmin') ||
                       (hasRole(['coordinadora', 'director', 'admin_centro']) && mismoCentro(userId) &&
                        request.resource.data.coordUid == request.auth.uid);
      allow delete: if isSuperadminByEmail() || currentRole() == 'superadmin' ||
                       (hasRole(['coordinadora', 'director', 'admin_centro']) && resource.data.coordUid == request.auth.uid);
    }

    // Evidencias del Portafolio Docente: un documento por evidencia (a diferencia de
    // users/{userId}/data/{doc}, que guarda un blob unico) para poder adjuntar archivos
    // sin toparse con el limite de 1 MiB por documento de Firestore. Sin chequeo por
    // resource.data (solo depende de userId), asi que no aplica el gotcha de "list" que
    // tuvo compartidos: el propio docente siempre puede listar todo lo suyo.
    match /users/{userId}/portafolio_evidencias/{itemId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
      allow read: if isSuperadminByEmail() || currentRole() == 'superadmin' ||
                     (hasRole(['coordinadora', 'director', 'admin_centro']) && mismoCentro(userId));

      // Adjunto de la evidencia (hasta 5 MB), partido en chunks -- mismo motivo que
      // portafolio_evidencias en si: no cabe en un solo documento.
      match /archivo/{chunkId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
        allow read: if isSuperadminByEmail() || currentRole() == 'superadmin' ||
                       (hasRole(['coordinadora', 'director', 'admin_centro']) && mismoCentro(userId));
      }
    }

    // Evidencia adjunta a una excusa de asistencia (certificado médico, carta, etc.):
    // un documento por (curso, fecha, estudiante), mismo criterio que portafolio_evidencias
    // -- el adjunto no cabe en el blob de asistencia (users/{userId}/data/asistencia).
    match /users/{userId}/asistencia_evidencias/{itemId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
      allow read: if isSuperadminByEmail() || currentRole() == 'superadmin' ||
                     (hasRole(['coordinadora', 'director', 'admin_centro']) && mismoCentro(userId));

      match /archivo/{chunkId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
        allow read: if isSuperadminByEmail() || currentRole() == 'superadmin' ||
                       (hasRole(['coordinadora', 'director', 'admin_centro']) && mismoCentro(userId));
      }
    }

    // Autoevaluación / plan de mejora del Portafolio Docente, un documento por año escolar.
    match /users/{userId}/portafolio_reflexion/{yearId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
      allow read: if isSuperadminByEmail() || currentRole() == 'superadmin' ||
                     (hasRole(['coordinadora', 'director', 'admin_centro']) && mismoCentro(userId));
    }

    // Evidencias PRIVADAS del Portafolio (ej. lo que se enlaza desde Mi Libreta):
    // a diferencia de portafolio_evidencias de arriba, aquí NO hay rama de lectura
    // para coordinadora/director/admin_centro/superadmin -- deliberadamente. Es el
    // único dato del portafolio que ni siquiera un supervisor del mismo centro puede
    // leer. Mismo patrón que users/{userId}/sessions (ver arriba): regla plana sin
    // depender de resource.data, para no reintroducir el gotcha de "list" que ya
    // documentamos en compartidos/mismoCentroOSinCentro.
    match /users/{userId}/portafolio_evidencias_privadas/{itemId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /error_logs/{logId} {
      // uid del reporte debe ser el del propio usuario logueado -- antes se podia
      // crear un reporte con cualquier uid ajeno (bajo impacto ya que la lectura
      // sigue acotada por centro, pero permitia "falsificar" a quien pertenece
      // un error en el Panel de Bugs).
      allow create: if signedIn() && request.resource.data.get('uid', null) == request.auth.uid;
      allow read: if signedIn() && (
        isSuperadminByEmail() || currentRole() == 'superadmin' ||
        (hasRole(['admin_centro', 'director']) && mismoCentro(resource.data.get('uid', null)))
      );
      allow update, delete: if false;
    }

    match /public_blogs/{userId}/posts/{postId} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == userId;
    }

    match /public_blogs/{userId}/submissions/{subId} {
      allow create: if true;
      allow read, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /public_blogs/{userId}/reportes_comportamiento/{repId} {
      allow create: if true;
      allow read: if canReadConvivenciaOwnerOrPsico(userId);
      allow update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /public_blogs/{userId}/denuncias/{denId} {
      allow create: if true;
      allow read: if canReadConvivenciaOwnerOrPsico(userId);
      allow update, delete: if signedIn() && request.auth.uid == userId;
    }

    // Reglas explícitas para consultas collectionGroup globales
    // (evita permission-denied cuando existen colecciones con el mismo nombre en otras rutas).
    match /{path=**}/reportes_comportamiento/{repId} {
      allow read: if canReadConvivenciaGlobalPorDoc();
    }

    match /{path=**}/denuncias/{denId} {
      allow read: if canReadConvivenciaGlobalPorDoc();
    }

    match /public_blogs/{userId}/datos_padre/{estId} {
      // Publico a proposito: los padres abren el reporte via un link con id corto
      // (links_padre) sin haber iniciado sesion.
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == userId;
    }

    // Calendario global heredado (reemplazado por centros/{id}/calendario). Se deja de
    // solo lectura unicamente para poder copiar sus datos al centro correspondiente;
    // ya no acepta escrituras nuevas.
    match /public_calendar/{doc} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /examenes/{examenId} {
      allow read, update, delete: if signedIn()
                                  && request.auth.uid == resource.data.docenteUid;
      allow create: if signedIn()
                    && request.resource.data.docenteUid == request.auth.uid;
      allow read: if resource.data.activo == true;

      match /respuestas/{respId} {
        // create queda abierto porque el estudiante responde SIN cuenta (examen.html
        // publico). read antes era "cualquier docente logueado" -- cualquier profesor,
        // de cualquier centro, podia leer las respuestas de examenes ajenos. Ahora
        // solo el docente dueno del examen (o superadmin) puede leerlas.
        allow create: if true;
        allow read: if signedIn() && (
          isSuperadminByEmail() || currentRole() == 'superadmin' ||
          get(/databases/$(database)/documents/examenes/$(examenId)).data.docenteUid == request.auth.uid
        );
      }
    }

    match /links_alumno/{id} {
      allow read: if true;
      allow create: if signedIn();
    }

    match /links_padre/{id} {
      allow read: if true;
      allow create: if signedIn();
    }

    match /{path=**}/datos_padre/{estId} {
      allow read: if true;
    }
  }
}
